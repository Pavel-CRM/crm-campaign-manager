generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String
  name               String?
  createdAt          DateTime  @default(now())
  trialEndsAt        DateTime?
  subscriptionStatus String    @default("trial")  // trial | active | expired | lifetime
  subscriptionPlan   String?                       // monthly | annual | lifetime
  subscriptionEndsAt DateTime?
  ykPaymentMethodId  String?
  isAdmin            Boolean   @default(false)
  organizations      Organization[]
  payments           Payment[]
}

model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  ykPaymentId String    @unique
  amount      Float
  plan        String
  status      String    @default("pending")  // pending | succeeded | cancelled
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())
}

model Organization {
  id         String              @id @default(cuid())
  name       String
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  settings   OrgSettings?
  activities Activity[]
  rules      CommunicationRule[]
}

model OrgSettings {
  id            String       @id @default(cuid())
  orgId         String       @unique
  org           Organization @relation(fields: [orgId], references: [id])
  description   String       @default("")
  services      String       @default("")
  products      String       @default("")
  newsletters   String       @default("")
  categories    String       @default("")
  channels      String       @default("[]")
  businessFocus String       @default("")
  topProducts   String       @default("")
}

model CommunicationRule {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  category  String
  channel   String
  frequency Int
  days      String       @default("[]")
  notes     String       @default("")
}

model Activity {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  title       String
  date        DateTime
  channels    String
  category    String
  status      String       @default("draft")
  content     String       @default("{}")
  isGenerated Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
